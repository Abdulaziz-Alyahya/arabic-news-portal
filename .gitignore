# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.pyc

# Environment variables and secrets
.env

# Local database and collected data
*.db
*.sqlite
*.sqlite3

# Keep the current portal database
!data/articles.db

# macOS files
.DS_Store

# VS Code settings
.vscode/

# Runtime logs
logs/

# Clean-start test environment
.venv-test/

# Local model-derived embeddings; never publish them with the site database
.cache/news-embeddings/

# Private source rate-limit state, restored separately by Actions
.cache/news-collection/

# Published standalone snapshot (authoritative in GitHub)
!data/news-snapshot.sqlite
